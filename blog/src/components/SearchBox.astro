---
// 搜索框：pagefind 官方组件版（light DOM，无需手写 JS）。
// 构建时 pagefind 索引落在 /pagefind/，组件自动加载索引。
// 组件渲染出的 .pf-* 节点是运行时生成的，scoped style 够不到，
// 外观覆盖统一写在 global.css 的「搜索（pagefind 覆盖）」段。
---

<div class="search-block">
  <span class="search-label">搜索</span>
  <div class="search">
    <pagefind-config bundle-path="/pagefind/"></pagefind-config>
    <pagefind-searchbox placeholder="搜索文章…" hide-shortcut></pagefind-searchbox>
  </div>
</div>

<style>
  .search-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .search-label {
    font-size: var(--fs-tagline);
    color: var(--c-muted);
    letter-spacing: var(--ls-label);
    line-height: 1.4;
    width: var(--search-w);
    text-align: right;
  }
  .search {
    position: relative;
    width: var(--search-w);
  }
  @media (max-width: 760px) {
    .search-block { align-items: flex-start; }
    .search-label { text-align: left; }
  }
</style>
