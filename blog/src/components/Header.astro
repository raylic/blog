---
import SearchBox from './SearchBox.astro';
// 站点头部：左 logo + tagline，右搜索框。宽度由父容器决定（shell = 900）。
---
<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-name">raylic.work</span>
    <span class="brand-tagline">写作 · 项目 · 笔记</span>
  </a>
  <SearchBox />
</header>

<style>
  .site-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: var(--header-pad-top) 0 var(--header-pad-bottom) var(--inset);
  }
  .brand { display: flex; flex-direction: column; gap: 11px; text-decoration: none; }
  .brand:hover { text-decoration: none; }
  .brand-name {
    font-family: var(--f-latin);
    font-size: var(--fs-site);
    color: var(--c-site);
    letter-spacing: 0.5px;
    line-height: 1.3;
  }
  .brand-tagline {
    font-size: var(--fs-tagline);
    color: var(--c-muted);
    letter-spacing: var(--ls-label);
    line-height: 1.8;
  }
  @media (max-width: 760px) {
    .site-header {
      flex-direction: column;
      gap: 24px;
      align-items: flex-start;
      padding: 40px 0;
    }
  }
</style>
