---
import { getCollection } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { slug as postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const all = (await getCollection('posts', ({ data }) => !data.draft)).filter(Boolean);
  return all.map((post) => ({ params: { slug: postSlug(post) } }));
}

const { slug } = Astro.params;
const all = (await getCollection('posts', ({ data }) => !data.draft)).filter(Boolean);
const post = all.find((p) => postSlug(p) === slug);
if (!post) {
  return new Response('Not Found', { status: 404 });
}
---

<Post post={post} allPosts={all} />
