---
import { getCollection } from 'astro:content';
import List from '../../layouts/List.astro';
import PostCard from '../../components/PostCard.astro';
import { seriesList } from '../../lib/posts';

export async function getStaticPaths() {
  const all = (await getCollection('posts', ({ data }) => !data.draft)).filter(Boolean);
  return seriesList(all).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const all = (await getCollection('posts', ({ data }) => !data.draft)).filter(Boolean);
const series = seriesList(all).find((s) => s.slug === slug);
if (!series) {
  return new Response('Not Found', { status: 404 });
}
---

<List title={`系列：${slug}`} description={`「${slug}」系列的全部文章`}>
  <section class="month">
    <div class="month-label">系列 · {slug}（{series.posts.length}）</div>
    {series.posts.map((p) => <PostCard post={p} />)}
  </section>
</List>
