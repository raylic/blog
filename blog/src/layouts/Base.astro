---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 页脚对齐方式：home = 跟首页 720 块居中，article = 跟文章正文同一左边缘 */
  footer?: 'home' | 'article';
}

const { title, description, footer = 'home' } = Astro.props;
const fullTitle = title ? `${title} · raylic.work` : 'raylic.work · 写作 · 项目 · 笔记';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? '写作 · 项目 · 笔记'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- pagefind：构建时生成的本地搜索，仅 build 后可用。
         pagefind.js 由 component-ui 在搜索时动态 import，不要再用经典 script 引入
         （classic script 解析 import.meta 会报错）。 -->
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" defer></script>
  </head>
  <body>
    <slot />
    <footer class={`smallprint${footer === 'article' ? ' smallprint-article' : ''}`}>
      <div class="shell">
        <p class="smallprint-inner">最近更新 2026-10-15 · raylic.work</p>
      </div>
    </footer>
  </body>
</html>
